                          "text": "Great! Your property looks like a strong potential listing.\r\n\r\nOur team may contact you soon to discuss pricing and marketing options."
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
        "6a077309ed92cf7a7ed8ac09": {
          "variants": {
            "default:en-us": [
              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "No problem 😊\r\n\r\nWhenever you're ready to sell, our team will be happy to help you with pricing, listings, and market guidance."
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
        "6a0774aced92cf7a7ed8ac54": {
          "variants": {
            "default:en-us": [
              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "Excellent choice 📈\r\n\r\nWe help investors discover profitable real estate opportunities.\r\n\r\nWhat type of investment are you interested in?"
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        }
      },
