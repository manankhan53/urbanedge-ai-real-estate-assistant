        "6a06170600074b3680bae09a": {
          "variants": {
            "default:en-us": [
              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "Welcome to UrbanEdge Properties 👋\r\n\r\nI’m your AI property assistant.\r\n\r\nI can help you:\r\n• Buy a property\r\n• Sell a property\r\n• Explore investment opportunities\r\n\r\nI’ll ask you a few quick questions so our team can better understand your goals and guide you properly.\r\n\r\nPlease type:\r\n1 for Buyer\r\n2 for Seller\r\n3 for Investor"
                        }
                      ]
                    }
                  ],
                  "delay": 1000
                }
              }
            ]
          }
        },
        "6a0618a700074b3680bae130": {
          "variants": {
            "default:en-us": [
              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "Great! Let’s find the perfect property for you 🏡\r\n\r\nWhat type of property are you interested in?"
